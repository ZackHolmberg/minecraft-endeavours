# Minecraft Server Configuration
# Edit these values, then run: docker compose up -d

# Server version (e.g. "1.21.4", or "LATEST" to always pull latest)
MC_VERSION=LATEST

# Memory allocation (adjust based on how much RAM your machine has)
MEMORY=4G

# Server name shown in the multiplayer list
SERVER_NAME=Minecraft With Friends

# Max players allowed online at once
MAX_PLAYERS=10

# Server difficulty: peaceful, easy, normal, hard
DIFFICULTY=normal

# Game mode for new players: survival, creative, adventure, spectator
GAMEMODE=survival

# Allow players to fly in survival mode (false recommended)
ALLOW_FLIGHT=false

# Seed for world generation (leave empty for random)
LEVEL_SEED=

# Whitelist: comma-separated list of allowed usernames (or "false" to disable).
# Server runs in offline-mode, so the whitelist is what gates who can join.
WHITELIST=LordoftheBlock


# Comma-separated list of player usernames to make operators (admin)
OPS=

# ---
# DuckDNS (dynamic DNS) — keeps your hostname pointed at your current public IP
# Sign up at https://www.duckdns.org to get these values
# ---

# Your subdomain (just the part before .duckdns.org, e.g. "zacks-mc")
DUCKDNS_SUBDOMAIN=minecraft-with-friends

# Your token from the top of the duckdns.org dashboard
DUCKDNS_TOKEN=17513b7c-3dda-4025-8129-b106d387b6cc
